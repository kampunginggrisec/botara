# Botara - PRODUCTION environment template.
# Copy to .env.production ON THE VPS ONLY and fill in real values there.
# NEVER commit a filled .env.production. Placeholders only in this file.
#
#   cp .env.production.example .env.production

# --- Domain (public hostname, no scheme). DNS A record must point to the VPS.
#     Used by Caddy for automatic HTTPS and by webhook URLs.
DOMAIN=botara.example.com

# --- PostgreSQL (container-internal; password generated on the VPS)
#     Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_URL is assembled by docker-compose.prod.yml from POSTGRES_PASSWORD;
# set it here only if you run the apps outside compose.
# DATABASE_URL=postgres://botara:CHANGE_ME@postgres:5432/botara

# --- Redis (container-internal; URL assembled by compose)
# REDIS_URL=redis://redis:6379

# --- Meta / WhatsApp (from your Meta app: developers.facebook.com)
#     App secret enables webhook signature verification (X-Hub-Signature-256).
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Long-lived system-user token for WhatsApp sends (Fase 1 env credential stub;
# replaced by the token vault in a later phase).
WHATSAPP_ACCESS_TOKEN=
# Any random string you choose; must match the verify token entered in the
# Meta app webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# --- Telegram (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Random secret sent by Telegram as X-Telegram-Bot-Api-Secret-Token.
#     Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Threads (separate Meta app use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- TikTok Business Messaging (Open Beta; separate TikTok app, see docs/tiktok.md)
#     App from https://business-api.tiktok.com/portal/apps - its id becomes
#     the OAuth client_key. Register the OAuth redirect URI
#     {PUBLIC_WEBHOOK_BASE_URL}/channels/tiktok/oauth/callback in the app.
#     The app must be APPROVED for the Business Messaging use case before
#     any business can connect. TIKTOK_ACCESS_TOKEN is an optional
#     DEVELOPMENT-ONLY stub (prefer the OAuth connect flow, which stores
#     per-business tokens in the vault).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Cloudflare R2 (S3-compatible object storage; from the R2 dashboard)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=botara-media
# Public media base URL: an R2 custom domain (never r2.dev in production).
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Resend (transactional email; API key from resend.com, domain must be verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com

# --- Secrets (generate on the VPS, never reuse across environments)
#     Generate each: openssl rand -hex 32
# Encryption key reference for the token vault (opaque pointer used in Fase 1+).
TOKEN_VAULT_KEY=
# Session/JWT secret for the auth system (lands in a later phase).
SESSION_SECRET=
JWT_SECRET=

# --- Fase 4 channel onboarding (dashboard connect flows)
# Public base URL where THIS API is reachable from the internet, including
# the /api prefix if your reverse proxy exposes it there (with the Caddy
# compose file the API is behind https://DOMAIN/api). OAuth redirect URIs
# are built as {PUBLIC_WEBHOOK_BASE_URL}/channels/<channel>/oauth/callback
# and the Telegram webhook as {PUBLIC_WEBHOOK_BASE_URL}/webhooks/telegram -
# register exactly those URLs in the Meta app dashboards.
PUBLIC_WEBHOOK_BASE_URL=https://botara.example.com/api
APP_PUBLIC_URL=https://botara.example.com
# WhatsApp Embedded Signup configuration id (Meta app dashboard).
WHATSAPP_EMBEDDED_CONFIG_ID=
# Instagram Login app credentials (fall back to META_APP_ID/SECRET if empty).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
