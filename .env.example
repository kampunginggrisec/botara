# Botara - local development environment (placeholders only, no real secrets)
PORT_API=3000
PORT_REALTIME=3002

DATABASE_URL=postgres://botara:botara@localhost:5432/botara
REDIS_URL=redis://localhost:6379

# Meta
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# WhatsApp (Fase 1: env credential stub + webhook verification)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Fase 2 channels (env credential stubs; per-account vault refs win)
INSTAGRAM_ACCESS_TOKEN=
MESSENGER_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=
THREADS_VERIFY_TOKEN=
META_VERIFY_TOKEN=

# AI (OpenAI-compatible endpoint; empty key disables ai-suggest with 503)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Telegram (bot token from @BotFather + optional webhook secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=botara-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com
RESEND_WEBHOOK_SECRET=

# Fase 4 channel onboarding (dashboard connect flows)
# Public base URL where THIS API is reachable from the internet, including
# any proxy path prefix (e.g. https://bot.example.com/api). Used for OAuth
# redirect URIs and the Telegram webhook registration; must match the
# redirect URIs registered in the Meta app dashboards. Falls back to
# APP_PUBLIC_URL / the request origin when unset.
PUBLIC_WEBHOOK_BASE_URL=
# Public app URL of the web app (OAuth callbacks redirect the browser here).
APP_PUBLIC_URL=
# WhatsApp Embedded Signup: configuration id from the Meta app dashboard.
# The dashboard's "Connect WhatsApp" button appears only when both
# META_APP_ID and this are set.
WHATSAPP_EMBEDDED_CONFIG_ID=
# Instagram Login (Business Login for Instagram) app credentials. When unset,
# the API falls back to META_APP_ID / META_APP_SECRET.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
